+// Enginehost: the engine below calls GameActivity's own instance methods
+// (setImmersiveMode, hasBackgroundMusic, buildFileTree, getCRequirePath, ...)
+// on SDL's context. Under the plugin-api transport that context is the host's
+// Activity, which has none of them (NoSuchMethodError, JNI abort). The plugin
+// runs a GameActivity stand-in as SDLActivity.mSingleton instead;
+// GameActivity.getGameActivity() hands it over, and it is SDL's context
+// itself again when GameActivity is the Activity (the stock path).
+static jobject getGameActivity(JNIEnv *env)
+{
+	jobject self = nullptr;
+	jclass clazz = env->FindClass("org/love2d/android/GameActivity");
+
+	if (clazz != nullptr)
+	{
+		jmethodID method = env->GetStaticMethodID(clazz, "getGameActivity", "()Lorg/love2d/android/GameActivity;");
+		if (method != nullptr)
+			self = env->CallStaticObjectMethod(clazz, method);
+		env->DeleteLocalRef(clazz);
+	}
+
+	if (env->ExceptionCheck())
+		env->ExceptionClear();
+
+	return self != nullptr ? self : (jobject) SDL_AndroidGetActivity();
+}
